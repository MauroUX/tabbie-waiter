{
  "name": "tabbie-waiter-replica",
  "version": "0.0.0",
  "private": true,
  "description": "Réplica propia del backend de Tabbie, construida desde el contrato del contexto (0010, DP-48).",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "migracion:correr": "node node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
    "migracion:deshacer": "node node_modules/typeorm/cli.js migration:revert -d dist/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/typeorm": "10.0.2",
    "firebase-admin": "13.10.0",
    "ioredis": "5.11.1",
    "js-yaml": "4.3.2",
    "mysql2": "3.24.6",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@types/express": "4.17.25",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.19.43",
    "@types/passport-jwt": "4.0.1",
    "typescript": "5.9.3"
  }
}
