# Perfil de pruebas de la réplica (DP-63). Se copia a replica/entornos/pruebas.env, que no entra al repo (.gitignore),
# y se completa con los valores. Este archivo trae solo los nombres: ninguna línea tiene valor.
# Se usa con: docker compose --env-file replica/entornos/pruebas.env up -d --build
# La suite: docker compose --env-file replica/entornos/pruebas.env --profile pruebas run --rm pruebas
# Referencia: docs/architecture/infraestructura.md, secciones 4 y 5.

# --- Base: MySQL ---
# Host de MySQL. Valor sugerido con compose.yaml: mysql
DB_HOST=
# Puerto de MySQL. Valor sugerido: 3306
DB_PORT=
# Usuario de MySQL. También crea el usuario del contenedor de MySQL.
DB_USER=
# Contraseña de MySQL. Secreto: no se versiona.
DB_PASSWORD=
# Nombre de la base. También crea la base del contenedor de MySQL.
DB_NAME=

# --- Redis ---
# Conexión a Redis en una sola cadena. Con compose.yaml se deja vacía y se usan las tres siguientes.
# Secreto si lleva la contraseña: no se versiona.
REDIS_URL=
# Host de Redis, si no se usa REDIS_URL. Valor sugerido con compose.yaml: redis
REDIS_HOST=
# Puerto de Redis, si no se usa REDIS_URL. Valor sugerido: 6379
REDIS_PORT=
# Contraseña de Redis, si no se usa REDIS_URL. Secreto: no se versiona.
REDIS_PASSWORD=

# --- Sesión: JWT propio ---
# Firma y valida el JWT del backend, y con él firman las pruebas el JWT del mozo (DP-15).
# Secreto: no se versiona. Un valor de prueba, distinto del de local.
JWT_SECRET=
# Vencimiento del JWT de los mozos. Se acorta en el perfil de pruebas cuando una prueba lo necesita (HU-01, HU-10); valor sugerido: 16h
JWT_EXPIRATION_WAITERS=
# Vencimiento del JWT de los demás usuarios.
JWT_EXPIRATION=

# --- Solicitudes de cobro ---
# Vencimiento, en segundos, de las solicitudes de cobro presencial en Redis. Corto en el perfil de pruebas (HU-06.h4).
# Valor sugerido en pruebas: 30
REDIS_EXPIRATION_TIME=

# --- Firebase ---
# Activa la verificación del ID token con Firebase Admin: solo con el valor true.
# Valor sugerido en pruebas: false (la CI corre sin Firebase, DP-43)
USE_FIREBASE=
# Proyecto de Firebase de Tabbie. Vacío con USE_FIREBASE desactivada.
FIREBASE_PROJECT_ID=
# Clave privada de la cuenta de servicio. Secreto: no se versiona. Vacía con USE_FIREBASE desactivada.
FIREBASE_PRIVATE_KEY=
# Email de la cuenta de servicio. Se trata como secreto: no se versiona. Vacío con USE_FIREBASE desactivada.
FIREBASE_CLIENT_EMAIL=

# --- Servidor ---
# Puerto donde escucha la réplica. Valor sugerido: 3000
PORT=
# Orígenes web permitidos. No afecta a la app nativa ni al simulador.
CORS_ORIGINS=
