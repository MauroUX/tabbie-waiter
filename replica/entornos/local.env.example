# Perfil normal de la réplica (DP-63). Se copia a replica/entornos/local.env, que no entra al repo (.gitignore),
# y se completa con los valores. Este archivo trae solo los nombres: ninguna línea tiene valor.
# Se usa con: docker compose --env-file replica/entornos/local.env up -d --build
# Referencia: docs/architecture/infraestructura.md, sección 5.

# --- Base: MySQL ---
# Host de MySQL. Valor sugerido con compose.yaml: mysql
DB_HOST=
# Puerto de MySQL. Valor sugerido: 3306
DB_PORT=
# Usuario de MySQL. También crea el usuario del contenedor de MySQL.
DB_USER=
# Contraseña de MySQL. Secreto: no se versiona.
DB_PASSWORD=
# Nombre de la base. También crea la base del contenedor de MySQL.
DB_NAME=

# --- Redis ---
# Conexión a Redis en una sola cadena (Redis administrado). Con compose.yaml se deja vacía y se usan las tres siguientes.
# Secreto si lleva la contraseña: no se versiona.
REDIS_URL=
# Host de Redis, si no se usa REDIS_URL. Valor sugerido con compose.yaml: redis
REDIS_HOST=
# Puerto de Redis, si no se usa REDIS_URL. Valor sugerido: 6379
REDIS_PORT=
# Contraseña de Redis, si no se usa REDIS_URL. Secreto: no se versiona.
REDIS_PASSWORD=

# --- Sesión: JWT propio ---
# Firma y valida el JWT del backend. Secreto: no se versiona. Distinto en cada entorno.
JWT_SECRET=
# Vencimiento del JWT de los mozos. Valor sugerido en local: 16h
JWT_EXPIRATION_WAITERS=
# Vencimiento del JWT de los demás usuarios.
JWT_EXPIRATION=

# --- Solicitudes de cobro ---
# Vencimiento, en segundos, de las solicitudes de cobro presencial en Redis. Valor sugerido en local: 3600
REDIS_EXPIRATION_TIME=

# --- Firebase ---
# Activa la verificación del ID token con Firebase Admin: solo con el valor true. Valor sugerido en local: true
USE_FIREBASE=
# Proyecto de Firebase de Tabbie.
FIREBASE_PROJECT_ID=
# Clave privada de la cuenta de servicio. Secreto: no se versiona.
FIREBASE_PRIVATE_KEY=
# Email de la cuenta de servicio. Se trata como secreto: no se versiona.
FIREBASE_CLIENT_EMAIL=

# --- Servidor ---
# Puerto donde escucha la réplica. Valor sugerido: 3000
PORT=
# Orígenes web permitidos. No afecta a la app nativa ni al simulador.
CORS_ORIGINS=

# --- Pruebas locales con Firebase (TK-02) ---
# Web API key del proyecto de Firebase: la usa solo el servicio `pruebas` para canjear email y contraseña por un ID token.
# Secreto: no se versiona.
FIREBASE_WEB_API_KEY=
